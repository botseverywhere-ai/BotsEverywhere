# Copy to .env only for local experiments. Do not commit real secrets.
# Template mode needs none of the values below.

# template (default) writes org/ from the dev UI.
# showcase is the read-only public site. sqlite turns the optional share-link API back on.
MODE=template
# Vite reads this when you start or build the web app. Keep it aligned with MODE.
# VITE_APP_MODE=template

# Email and Slack sign-in. false is the demo default: no mail provider, Slack app, or API keys required.
# Set true only if you want the optional account sign-in routes.
AUTH_ENABLED=false

# Public site origin. Share links use this origin. Slack's redirect URL is ${APP_ORIGIN}/api/auth/slack/callback
APP_ORIGIN=https://botseverywhere.ai

# Listen address. nginx proxies /api here.
HOST=127.0.0.1
PORT=8787

# SQLite file. Move the same schema to Postgres later by swapping the Drizzle driver.
SQLITE_PATH=/var/lib/botseverywhere/botseverywhere.sqlite

# Directory of curated bot markdown files.
BOTS_DIR=/opt/botseverywhere/bots

# httpOnly session cookies. Set true only behind HTTPS.
COOKIE_SECURE=true

# Trust X-Forwarded-For from nginx for OTP rate limits.
TRUST_PROXY=true

# Secret mixed into sign-in code hashes. Use a long random string.
OTP_PEPPER=replace-with-a-long-random-string

# console | ses | resend
# Used only when AUTH_ENABLED=true. Production then refuses to boot on console.
# Leave unset while sign-in is off.
# MAIL_PROVIDER=ses

# Amazon SES. On EC2, omit the keys and attach an instance role that can ses:SendEmail.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
SES_FROM=BotsEverywhere <hello@botseverywhere.ai>

# Resend, if MAIL_PROVIDER=resend
# RESEND_API_KEY=
# RESEND_FROM=BotsEverywhere <hello@botseverywhere.ai>

# Slack OpenID Connect app. Redirect URL must match APP_ORIGIN.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
