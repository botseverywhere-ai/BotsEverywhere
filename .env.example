# Copy to .env only when you want to change a default. The local app needs none of these.

# Which build runs. Leave both unset for the local app (template mode): npm run dev starts the site and the file writer.
# showcase is the read-only public site: sample organizations and the directory, no file writer.
# MODE=template
# VITE_APP_MODE=template

# Where the file writer keeps your organizations. Default: the orgs folder beside this file.
# ORGS_DIR=./orgs

# Ports. The writer starts at 8787 and the site at 5199; each walks forward if its port is taken.
# PORT=8787
# WEB_PORT=5199

# The repository link shown on the public site.
# VITE_REPO_URL=https://github.com/botseverywhere-ai/botseverywhere
