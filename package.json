{
  "name": "botseverywhere",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev-all.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5199",
    "dev:api": "tsx server/src/index.ts",
    "validate:bots": "tsx scripts/validate-bots.ts",
    "validate:mock": "tsx scripts/validate-mock-companies.ts",
    "validate:org": "tsx scripts/validate-org.ts",
    "validate:directory": "tsx scripts/validate-directory.ts",
    "generate:bots": "tsx scripts/validate-bots.ts --write",
    "build": "npm run validate:org && npm run validate:directory && npm run validate:mock && npm run generate:bots && tsc -b && vite build && tsc -p server/tsconfig.json",
    "test": "node --import tsx --test server/test/*.test.ts",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 5199"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "html-to-image": "^1.11.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
